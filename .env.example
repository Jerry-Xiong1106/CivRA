# Environment variables
# Copy this file to .env for local development.
SILICONFLOW_API_KEY=
RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
RAG_EMBEDDING_MODEL=BAAI/bge-m3
# Per-request HTTP timeout; retries are owned by the caller/Runtime.
RAG_EMBEDDING_TIMEOUT_S=30
# Real statute retrieval: exact route + metadata vectors by default.
# Set keyword explicitly for offline keyword-only experiments.
CIVRA_RETRIEVAL_MODE=exact-vector

# Agent model (backend/agent/factory.py). SILICONFLOW_API_KEY above is enough;
# these optional overrides default to SiliconFlow and Qwen/Qwen2.5-7B-Instruct.
# CIVRA_LLM_MODEL=
# CIVRA_LLM_BASE_URL=
# CIVRA_LLM_API_KEY=
# CIVRA_LLM_PRICE_IN=       # yuan per million input tokens, for cost estimates
# CIVRA_LLM_PRICE_OUT=      # yuan per million output tokens
# CIVRA_LLM_PRICE_VERSION=

# Frontend HTTP API: a single trusted workspace (one server process).
# CIVRA_API_TOKEN=
# DEEPSEEK_API_KEY=          # optional: DeepSeek Flash, non-thinking
# CIVRA_API_DATA_DIR=var/api
# CIVRA_API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
