# Environment variables
# Copy this file to .env for local development.
SILICONFLOW_API_KEY=
RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
RAG_EMBEDDING_MODEL=BAAI/bge-m3

# Agent model (backend/agent/factory.py). SILICONFLOW_API_KEY above is enough;
# these optional overrides default to SiliconFlow and Qwen/Qwen2.5-7B-Instruct.
# CIVRA_LLM_MODEL=
# CIVRA_LLM_BASE_URL=
# CIVRA_LLM_API_KEY=
# CIVRA_LLM_PRICE_IN=       # yuan per million input tokens, for cost estimates
# CIVRA_LLM_PRICE_OUT=      # yuan per million output tokens
# CIVRA_LLM_PRICE_VERSION=
